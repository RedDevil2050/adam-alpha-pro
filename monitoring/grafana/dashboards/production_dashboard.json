{
  "dashboard": {
    "id": null,
    "title": "Zion Market Analysis - Production Dashboard",
    "tags": ["zion", "production", "market"],
    "style": "dark",
    "timezone": "Asia/Kolkata",
    "editable": true,
    "hideControls": false,
    "graphTooltip": 1,
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "refresh": "30s",
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "System Health Overview",
        "type": "stat",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "targets": [
          {
            "expr": "up{job=\"zion-backend\"}",
            "legendFormat": "API Health",
            "refId": "A"
          },
          {
            "expr": "zion_active_sessions",
            "legendFormat": "Active Sessions",
            "refId": "B"
          },
          {
            "expr": "rate(zion_request_count[5m])",
            "legendFormat": "Requests/sec",
            "refId": "C"
          },
          {
            "expr": "zion_system_cpu_usage_percent",
            "legendFormat": "CPU Usage %",
            "refId": "D"
          }
        ],
        "thresholds": {
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 70},
            {"color": "red", "value": 90}
          ]
        }
      },
      {
        "id": 2,
        "title": "API Performance",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(zion_request_latency_seconds_bucket[5m]))",
            "legendFormat": "95th Percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(zion_request_latency_seconds_bucket[5m]))",
            "legendFormat": "50th Percentile",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Response Time (seconds)",
            "min": 0
          }
        ],
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      {
        "id": 3,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(zion_request_count[5m])",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Requests per Second",
            "min": 0
          }
        ]
      },
      {
        "id": 4,
        "title": "Agent Performance",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 17},
        "targets": [
          {
            "expr": "rate(zion_agent_executions_total[5m])",
            "legendFormat": "{{agent_name}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Agent Executions/sec",
            "min": 0
          }
        ]
      },
      {
        "id": 5,
        "title": "Data Provider Status",
        "type": "stat",
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 17},
        "targets": [
          {
            "expr": "rate(zion_data_provider_requests_total{status=\"success\"}[5m])",
            "legendFormat": "{{provider}} Success",
            "refId": "A"
          },
          {
            "expr": "rate(zion_data_provider_requests_total{status=\"error\"}[5m])",
            "legendFormat": "{{provider}} Error",
            "refId": "B"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area"
        }
      },
      {
        "id": 6,
        "title": "Cache Performance",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 26},
        "targets": [
          {
            "expr": "rate(zion_cache_hits_total[5m])",
            "legendFormat": "Cache Hits",
            "refId": "A"
          },
          {
            "expr": "rate(zion_cache_misses_total[5m])",
            "legendFormat": "Cache Misses",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Operations per Second",
            "min": 0
          }
        ]
      },
      {
        "id": 7,
        "title": "System Resources",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 26},
        "targets": [
          {
            "expr": "zion_system_cpu_usage_percent",
            "legendFormat": "CPU %",
            "refId": "A"
          },
          {
            "expr": "zion_system_memory_usage_percent",
            "legendFormat": "Memory %",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Usage Percentage",
            "min": 0,
            "max": 100
          }
        ],
        "thresholds": [
          {
            "value": 80,
            "colorMode": "critical",
            "op": "gt",
            "fill": true,
            "line": true
          }
        ]
      },
      {
        "id": 8,
        "title": "Error Rate",
        "type": "stat",
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 35},
        "targets": [
          {
            "expr": "rate(zion_request_count{http_status=~\"5..\"}[5m]) / rate(zion_request_count[5m]) * 100",
            "legendFormat": "5xx Error Rate %",
            "refId": "A"
          },
          {
            "expr": "rate(zion_request_count{http_status=~\"4..\"}[5m]) / rate(zion_request_count[5m]) * 100",
            "legendFormat": "4xx Error Rate %",
            "refId": "B"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "center"
        },
        "thresholds": {
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 5}
          ]
        }
      },
      {
        "id": 9,
        "title": "Market Data Feed Status",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 41},
        "targets": [
          {
            "expr": "zion_data_provider_requests_total",
            "legendFormat": "{{provider}}-{{status}}",
            "refId": "A",
            "format": "table"
          }
        ],
        "options": {
          "showHeader": true
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            }
          }
        }
      }
    ],
    "templating": {
      "list": []
    },
    "links": [],
    "version": 1
  }
}
